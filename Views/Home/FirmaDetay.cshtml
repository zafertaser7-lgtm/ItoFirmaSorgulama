@model dynamic

@{
    Layout = null;
    ViewData["Title"] = "Firma Detay";

    string firmaAdi = Convert.ToString(Model.Unvan);
    string adres = Convert.ToString(Model.Adres);
    string ilce = Convert.ToString(Model.IlceAdi);

    string mapQuery =
        $"{firmaAdi}, {adres}, {ilce}, İzmir, Türkiye";

    string googleMapsUrl =
        "https://www.google.com/maps/search/?api=1&query=" +
        Uri.EscapeDataString(mapQuery);
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>@Model.Unvan - Firma Detay</title>

    <link rel="icon"
          href="/images/ito-logo.png"
          type="image/png">

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            background: #f4f7fb;
            color: #1f2937;
            transition: background-color .2s ease, color .2s ease;
        }

        /* =========================
                   HEADER
                   ========================= */

        .header {
            background: linear-gradient(135deg, #003366, #0066b3);
            color: white;
            padding: 17px 35px;
            display: flex;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0,0,0,.15);
        }

        .logo {
            height: 52px;
            margin-right: 18px;
        }

        .header h1 {
            font-size: 23px;
            font-weight: 600;
        }

        .theme-wrapper {
            margin-left: auto;
        }

        #theme-toggle {
            border: 1px solid rgba(255,255,255,.5);
            background: rgba(255,255,255,.12);
            color: white;
            padding: 9px 15px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 600;
            transition: .2s;
        }

            #theme-toggle:hover {
                background: rgba(255,255,255,.25);
            }

        /* =========================
                   CONTAINER
                   ========================= */

        .container {
            max-width: 1150px;
            margin: 35px auto;
            padding: 0 20px;
        }

        /* =========================
                   GERİ DÖN
                   ========================= */

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 22px;
            padding: 10px 17px;
            background: white;
            color: #00509e;
            border: 1px solid #d4dce5;
            border-radius: 7px;
            text-decoration: none;
            font-weight: 600;
            transition: .2s;
        }

            .back-button:hover {
                background: #00509e;
                color: white;
                border-color: #00509e;
            }

        /* =========================
                   FİRMA KARTI
                   ========================= */

        .company-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 8px 30px rgba(0,0,0,.08);
            overflow: hidden;
            transition: background-color .2s ease, box-shadow .2s ease;
        }

        .company-header {
            background: linear-gradient(135deg, #003366, #0066b3);
            color: white;
            padding: 32px 35px;
        }

        .company-title-small {
            font-size: 12px;
            letter-spacing: 1.5px;
            opacity: .8;
            margin-bottom: 9px;
            font-weight: 600;
        }

        .company-name {
            font-size: 30px;
            line-height: 1.35;
            font-weight: 700;
        }

        .content {
            padding: 30px 35px;
        }

        /* =========================
                   SECTION
                   ========================= */

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 17px;
            color: #003366;
            margin-bottom: 17px;
            font-weight: 700;
        }

            .section-title::before {
                content: "";
                width: 4px;
                height: 21px;
                background: #0066b3;
                border-radius: 5px;
            }

        /* =========================
                   BİLGİLER
                   ========================= */

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 17px;
        }

        .info-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            padding: 18px 20px;
            transition: .2s;
        }

            .info-box:hover {
                border-color: #b8cee3;
                box-shadow: 0 4px 12px rgba(0,80,158,.07);
                transform: translateY(-1px);
            }

            .info-box.full {
                grid-column: 1 / -1;
            }

        .info-label {
            display: block;
            color: #6b7280;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 7px;
        }

        .info-value {
            color: #1f2937;
            font-size: 15px;
            line-height: 1.6;
            word-break: break-word;
        }

        .profession-badge {
            display: inline-block;
            padding: 7px 12px;
            background: #e8f2fc;
            color: #00509e;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        .website-link {
            color: #00509e;
            text-decoration: none;
            font-weight: 600;
        }

            .website-link:hover {
                text-decoration: underline;
            }

        .empty-value {
            color: #9ca3af;
            font-style: italic;
        }

        /* =========================
                   HARİTA
                   ========================= */

        .map-section {
            margin-top: 25px;
            background: white;
            border-radius: 14px;
            box-shadow: 0 8px 30px rgba(0,0,0,.08);
            padding: 30px 35px;
            transition: background-color .2s ease, box-shadow .2s ease;
        }

        .map-box {
            min-height: 260px;
            border-radius: 10px;
            background: linear-gradient( 135deg, #eef4f9, #f8fafc );
            border: 1px solid #dbe4ed;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 30px;
        }

        .map-icon {
            font-size: 45px;
            margin-bottom: 12px;
        }

        .map-title {
            font-size: 18px;
            font-weight: 700;
            color: #003366;
            margin-bottom: 8px;
        }

        .map-address {
            color: #6b7280;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .map-button {
            display: inline-block;
            background: #00509e;
            color: white;
            text-decoration: none;
            padding: 11px 20px;
            border-radius: 7px;
            font-weight: 700;
            transition: .2s;
        }

            .map-button:hover {
                background: #003366;
                transform: translateY(-2px);
                box-shadow: 0 5px 12px rgba(0,51,102,.2);
            }

        /* =========================
                   FOOTER
                   ========================= */

        .detail-footer {
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
            color: #6b7280;
            font-size: 13px;
        }

        /* =========================
                   DARK MODE
                   ========================= */

        body.dark-mode {
            background: #111827;
            color: #f9fafb;
        }

            body.dark-mode .back-button {
                background: #1f2937;
                color: #93c5fd;
                border-color: #374151;
            }

                body.dark-mode .back-button:hover {
                    background: #00509e;
                    color: white;
                }

            body.dark-mode .company-card,
            body.dark-mode .map-section {
                background: #1f2937;
                box-shadow: 0 8px 30px rgba(0,0,0,.35);
            }

            body.dark-mode .company-header {
                background: linear-gradient( 135deg, #172554, #1d4ed8 );
            }

            body.dark-mode .section-title {
                color: #bfdbfe;
            }

            body.dark-mode .info-box {
                background: #273449;
                border-color: #374151;
            }

                body.dark-mode .info-box:hover {
                    border-color: #4b5563;
                    box-shadow: 0 4px 12px rgba(0,0,0,.25);
                }

            body.dark-mode .info-label {
                color: #9ca3af;
            }

            body.dark-mode .info-value {
                color: #f9fafb;
            }

            body.dark-mode .profession-badge {
                background: #1e3a5f;
                color: #93c5fd;
            }

            body.dark-mode .website-link {
                color: #93c5fd;
            }

            body.dark-mode .empty-value,
            body.dark-mode .detail-footer {
                color: #9ca3af;
            }

            body.dark-mode .map-box {
                background: linear-gradient( 135deg, #273449, #1f2937 );
                border-color: #374151;
            }

            body.dark-mode .map-title {
                color: #bfdbfe;
            }

            body.dark-mode .map-address {
                color: #9ca3af;
            }

        /* =========================
                   RESPONSIVE
                   ========================= */

        @@media (max-width: 750px) {

            .header {
                padding: 15px 20px;
            }

            .logo {
                height: 42px;
            }

            .header h1 {
                font-size: 18px;
            }

            .container {
                margin-top: 25px;
            }

            .company-header {
                padding: 25px 22px;
            }

            .company-name {
                font-size: 22px;
            }

            .content,
            .map-section {
                padding: 23px 20px;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .info-box.full {
                grid-column: auto;
            }

            #theme-text {
                display: none;
            }
        }

    </style>

</head>

<body>

    <header class="header">

        <img src="/images/ito-logo.png"
             alt="İTO Logo"
             class="logo">

        <h1>
            Üye Firma Sorgulama
        </h1>

        <div class="theme-wrapper">

            <button id="theme-toggle"
                    type="button">

                <span id="theme-icon">🌙</span>

                <span id="theme-text">
                    Koyu Mod
                </span>

            </button>

        </div>

    </header>


    <main class="container">

        <a href="/"
           class="back-button">

            ← Firma Arama Sonuçlarına Dön

        </a>


        <section class="company-card">

            <div class="company-header">

                <div class="company-title-small">
                    FİRMA PROFİLİ
                </div>

                <div class="company-name">
                    @Model.Unvan
                </div>

            </div>


            <div class="content">

                <div class="section-title">
                    Firma Bilgileri
                </div>


                <div class="info-grid">

                    <div class="info-box">

                        <span class="info-label">
                            Oda Sicil No
                        </span>

                        <div class="info-value">
                            @Model.OdaSicilNo
                        </div>

                    </div>


                    <div class="info-box">

                        <span class="info-label">
                            Ticaret Sicil No
                        </span>

                        <div class="info-value">
                            @Model.TicaretSicilNo
                        </div>

                    </div>


                    <div class="info-box">

                        <span class="info-label">
                            Meslek Grubu
                        </span>

                        <div class="info-value">

                            <span class="profession-badge">
                                @Model.GrupAdi
                            </span>

                        </div>

                    </div>


                    <div class="info-box">

                        <span class="info-label">
                            İlçe
                        </span>

                        <div class="info-value">
                            @Model.IlceAdi
                        </div>

                    </div>


                    <div class="info-box full">

                        <span class="info-label">
                            Adres
                        </span>

                        <div class="info-value">

                            @if (!string.IsNullOrWhiteSpace(
                                                        Convert.ToString(Model.Adres)))
                            {
                                @Model.Adres
                            }
                            else
                            {
                                <span class="empty-value">
                                    Adres bilgisi bulunmamaktadır.
                                </span>
                            }

                        </div>

                    </div>


                    <div class="info-box full">

                        <span class="info-label">
                            Web Sitesi
                        </span>

                        <div class="info-value">

                            @if (!string.IsNullOrWhiteSpace(
                                                        Convert.ToString(Model.WebAdresi)))
                            {
                                var web =
                                Convert.ToString(Model.WebAdresi);

                                if (!web.StartsWith("http://") &&
                                !web.StartsWith("https://"))
                                {
                                    web =
                                    "https://" + web;
                                }

                                <a href="@web"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="website-link">

                                    @Model.WebAdresi

                                </a>
                            }
                            else
                            {
                                <span class="empty-value">
                                    Web sitesi bulunmamaktadır.
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <div class="detail-footer">

                    İTO üye firma sorgulama sistemi üzerinden
                    görüntülenen firma bilgileri.

                </div>

            </div>

        </section>


        <section class="map-section">

            <div class="section-title">
                Firma Konumu
            </div>

            <div class="map-box">

                <div>

                    <div class="map-icon">
                        📍
                    </div>

                    <div class="map-title">
                        Google Maps'te Firma Konumu
                    </div>

                    <div class="map-address">

                        @Model.Adres

                        <br>

                        @Model.IlceAdi / İzmir

                    </div>

                    <a href="@googleMapsUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="map-button">

                        Google Maps'te Görüntüle

                    </a>

                </div>

            </div>

        </section>

    </main>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const themeToggle =
                document.getElementById("theme-toggle");

            const themeIcon =
                document.getElementById("theme-icon");

            const themeText =
                document.getElementById("theme-text");


            function applyTheme(theme) {

                if (theme === "dark") {

                    document.body.classList.add(
                        "dark-mode"
                    );

                    themeIcon.textContent =
                        "☀️";

                    themeText.textContent =
                        "Açık Mod";

                }
                else {

                    document.body.classList.remove(
                        "dark-mode"
                    );

                    themeIcon.textContent =
                        "🌙";

                    themeText.textContent =
                        "Koyu Mod";
                }
            }


            const savedTheme =
                localStorage.getItem(
                    "user-theme"
                );


            if (savedTheme) {

                applyTheme(savedTheme);

            }
            else {

                applyTheme("light");

            }


            themeToggle.addEventListener(
                "click",
                function () {

                    const isDark =
                        document.body.classList.contains(
                            "dark-mode"
                        );


                    const newTheme =
                        isDark
                            ? "light"
                            : "dark";


                    localStorage.setItem(
                        "user-theme",
                        newTheme
                    );


                    applyTheme(newTheme);

                }
            );

        });

    </script>

</body>
</html>