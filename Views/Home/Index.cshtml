@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Üye Firma Sorgulama</title>
    <link rel="icon" href="~/images/ito-logo.png" type="image/png">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.all.min.js"></script>

    <style>
        /* =========================================
              1. GENEL AYARLAR VE STANDART TEMA
           ========================================= */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            transition: background-color .14s ease, color .14s ease;
            background-color: #f4f7f6;
            color: #333;
        }

        .search-panel,
        .data-table-container,
        .header,
        #theme-toggle,
        input,
        button,
        table,
        thead,
        tbody tr,
        tfoot,
        .page-btn {
            transition: background-color .14s ease, color .14s ease, border-color .14s ease, box-shadow .14s ease;
        }

        .header {
            background: linear-gradient(135deg, #003366 0%, #00509e 100%);
            color: white;
            padding: 15px 30px;
            display: flex;
            align-items: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .logo-img {
            height: 55px;
            width: auto;
            margin-right: 20px;
        }

        .header h1 {
            font-size: 24px;
            letter-spacing: 1px;
            margin: 0;
        }

        .theme-btn-wrapper {
            margin-left: auto;
        }

        #theme-toggle {
            background-color: rgba(255, 255, 255, 0.2);
            color: white;
            border: 1px solid rgba(255,255,255,0.5);
            padding: 8px 15px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all .18s ease;
            will-change: transform;
        }

            #theme-toggle:hover {
                background-color: rgba(255, 255, 255, 0.3);
            }

            #theme-toggle:active {
                transform: scale(.94);
            }

        .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .search-panel {
            background-color: white;
            padding: 25px;
            border-radius: 8px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
        }

        .form-group {
            display: flex;
            gap: 20px;
            margin-bottom: 15px;
            align-items: flex-end;
        }

        .input-item {
            display: flex;
            flex-direction: column;
            flex: 1;
        }

            .input-item label {
                font-size: 13px;
                font-weight: 600;
                color: #003366;
                margin-bottom: 6px;
                transition: color 0.3s ease;
            }

            .input-item input {
                padding: 11px 12px;
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                font-size: 14px;
                background-color: #fff;
                transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            }

                .input-item input:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 6px 15px rgba(0, 80, 158, 0.12);
                    border-color: #00509e;
                }

            .input-item:hover label {
                color: #00509e;
            }

            .input-item input:focus {
                border-color: #00509e;
                outline: none;
                transform: translateY(-3px) scale(1.01);
                box-shadow: 0 0 0 3px rgba(0, 80, 158, 0.2), 0 8px 20px rgba(0, 80, 158, 0.15);
            }

        /* =========================================================
                   2. YENİ NESİL AÇILIR KUTU (CUSTOM SELECT) EFEKTLERİ
                   ========================================================= */
        .custom-select-wrapper {
            position: relative;
            user-select: none;
            width: 100%;
        }

        .custom-select-trigger {
            padding: 11px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 14px;
            background-color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
            position: relative;
            z-index: 2;
        }

            .custom-select-trigger:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(0, 80, 158, 0.15);
                border-color: #00509e;
            }

        .custom-select-wrapper.open {
            z-index: 100;
        }

            .custom-select-wrapper.open .custom-select-trigger {
                border-color: #00509e;
                box-shadow: 0 0 0 3px rgba(0, 80, 158, 0.2), 0 8px 20px rgba(0, 80, 158, 0.15);
                transform: translateY(-3px) scale(1.01);
            }

        .custom-options {
            position: absolute;
            display: block;
            top: 110%;
            left: 0;
            right: 0;
            background: #fff;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.2);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(-20px) scale(0.95) rotateX(5deg);
            transform-origin: top center;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            max-height: 300px;
            overflow-y: auto;
            scrollbar-width: thin;
        }

        .custom-select-wrapper.open .custom-options {
            opacity: 1;
            visibility: visible;
            pointer-events: all;
            transform: translateY(0) scale(1) rotateX(0deg);
        }

        .custom-option {
            padding: 14px 20px;
            font-size: 14px;
            color: #444;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            border-bottom: 1px solid #f8f9fa;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

            .custom-option::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                height: 100%;
                width: 4px;
                background-color: #00509e;
                transform: scaleY(0);
                transition: transform 0.3s ease;
                transform-origin: center;
            }

            .custom-option:hover {
                background-color: #f0f7ff;
                color: #00509e;
                font-weight: 600;
                padding-left: 35px;
                box-shadow: inset 0 0 10px rgba(0, 80, 158, 0.05);
            }

                .custom-option:hover::before {
                    transform: scaleY(1);
                }

            .custom-option.selected {
                background-color: #00509e;
                color: #fff;
                font-weight: bold;
                padding-left: 35px;
            }

        .arrow {
            font-size: 10px;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .custom-select-wrapper.open .arrow {
            transform: rotate(180deg);
        }

        .custom-options::-webkit-scrollbar {
            width: 8px;
        }

        .custom-options::-webkit-scrollbar-track {
            background: #f8f9fa;
            border-radius: 0 8px 8px 0;
        }

        .custom-options::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 8px;
            border: 2px solid #f8f9fa;
        }

            .custom-options::-webkit-scrollbar-thumb:hover {
                background-color: #a0aec0;
            }
        /* ========================================================= */

        .search-input-wrapper {
            display: flex;
            gap: 10px;
        }

            .search-input-wrapper input {
                flex: 1;
            }

        /* RAZOR İÇİN DÜZELTİLDİ (@@) */
        @@keyframes pulse-green {
            0% {
                box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.6);
            }

            70% {
                box-shadow: 0 0 0 8px rgba(40, 167, 69, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(40, 167, 69, 0);
            }
        }

        .btn-search {
            background-color: #28a745;
            color: white;
            border: none;
            padding: 0 25px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.2s, transform 0.2s;
        }

            .btn-search:hover {
                background-color: #218838;
                animation: pulse-green 1.5s infinite;
                transform: translateY(-2px);
            }

            .btn-search:disabled {
                background-color: #6c757d;
                cursor: not-allowed;
                animation: none;
            }

        .action-item {
            display: flex;
            align-items: flex-end;
            margin-left: auto;
        }

        .btn-excel {
            background-color: #00509e;
            color: white;
            border: none;
            padding: 11px 22px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: background-color 0.2s, transform 0.2s, box-shadow 0.2s;
        }

            .btn-excel:hover {
                background-color: #003366;
                box-shadow: 0 4px 12px rgba(0, 80, 158, 0.3);
                transform: translateY(-2px);
            }

        /* RAZOR İÇİN DÜZELTİLDİ (@@) */
        @@keyframes bounce-icon {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-4px);
            }
        }

        .btn-excel:hover svg {
            animation: bounce-icon 0.8s ease-in-out infinite;
        }

        .spinner {
            border: 2px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top: 2px solid #fff;
            width: 16px;
            height: 16px;
            animation: spin 0.8s linear infinite;
            display: inline-block;
            margin-right: 8px;
        }

        /* RAZOR İÇİN DÜZELTİLDİ (@@) */
        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Tablo */
        .data-table-container {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            border: 1px solid #e0e0e0;
            margin-top: 20px;
            max-height: 550px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #a0aec0 #ffffff;
            scroll-behavior: smooth;
        }

            .data-table-container::-webkit-scrollbar {
                width: 10px;
            }

            .data-table-container::-webkit-scrollbar-track {
                background: transparent;
            }

            .data-table-container::-webkit-scrollbar-thumb {
                background-color: #a0aec0;
                border-radius: 10px;
                border: 2px solid #ffffff;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        thead {
            background-color: #e9ecef;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        th {
            padding: 15px;
            font-size: 14px;
            color: #003366;
            border-bottom: 2px solid #dee2e6;
        }

        td {
            padding: 12px 15px;
            font-size: 14px;
            border-bottom: 1px solid #f0f0f0;
        }

        tbody tr:hover {
            background: #eef6ff;
            box-shadow: 0 4px 12px rgba(0,80,158,.10);
            transform: translateY(-1px);
            transition: .18s;
        }

        .empty-state {
            text-align: center;
            padding: 30px;
            color: #6c757d;
            font-style: italic;
        }

        #firmaTable tfoot {
            position: sticky;
            bottom: 0;
            z-index: 3;
        }

            #firmaTable tfoot td {
                background-color: #f1f3f5;
                border-top: 2px solid #cbd5e1;
                padding: 12px 20px;
                box-shadow: 0 -5px 10px rgba(0, 0, 0, 0.05);
            }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            flex-wrap: wrap;
            gap: 10px;
        }

        .total-count-wrapper {
            color: #2c3e50;
            font-weight: 700;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .count-badge {
            background-color: #00509e;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 14px;
            display: inline-block;
        }

        .range-info {
            font-weight: normal;
            color: #555;
            font-size: 13px;
            margin-right: 8px;
        }

        .pagination-container {
            display: flex;
            gap: 5px;
            align-items: center;
        }

        .page-btn {
            border: 1px solid #cbd5e1;
            background: #fff;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            color: #00509e;
            font-weight: bold;
            font-size: 13px;
            transition: all 0.2s;
        }

            .page-btn:hover:not(.disabled) {
                background: #e9ecef;
            }

            .page-btn.active {
                background: #00509e;
                color: #fff;
                border-color: #00509e;
                cursor: default;
            }

            .page-btn.disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

        .pulse-effect {
            animation: badgePulse 0.4s ease-out;
        }
        /* RAZOR İÇİN DÜZELTİLDİ (@@) */
        @@keyframes badgePulse {
            0% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(0, 80, 158, 0.7);
            }

            70% {
                transform: scale(1.15);
                box-shadow: 0 0 0 6px rgba(0, 80, 158, 0);
            }

            100% {
                transform: scale(1);
            }
        }
        /* RAZOR İÇİN DÜZELTİLDİ (@@) */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in-row {
            animation: fadeInUp 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
            opacity: 0;
        }

        /* Koyu Mod Uyumlu Custom Select */
        body.dark-mode {
            background-color: #121212 !important;
            color: #f8f9fa !important;
        }

        html {
            scroll-behavior: smooth;
        }

        body.dark-mode .header {
            background: #1e1e1e !important;
            border-bottom: 1px solid #333;
        }

        body.dark-mode #theme-toggle {
            background-color: #333;
            border: 1px solid #555;
        }

        body.dark-mode .search-panel, body.dark-mode .data-table-container {
            background-color: #1e1e1e !important;
            border: 1px solid #333 !important;
            box-shadow: 0 6px 20px rgba(0,0,0,0.5) !important;
        }

        body.dark-mode .input-item input {
            background-color: #2a2a2a !important;
            color: #f8f9fa !important;
            border-color: #444 !important;
        }

            body.dark-mode .input-item input:hover {
                box-shadow: 0 6px 15px rgba(110, 168, 254, 0.1) !important;
                border-color: #5c8ed6 !important;
            }

            body.dark-mode .input-item input:focus {
                border-color: #6ea8fe !important;
                box-shadow: 0 0 0 3px rgba(110, 168, 254, 0.2), 0 8px 20px rgba(110, 168, 254, 0.15) !important;
            }

        body.dark-mode .input-item label {
            color: #cbd5e1 !important;
        }

        body.dark-mode .input-item:hover label {
            color: #6ea8fe !important;
        }

        body.dark-mode .custom-select-trigger {
            background-color: #2a2a2a !important;
            border-color: #444 !important;
            color: #f8f9fa !important;
        }

            body.dark-mode .custom-select-trigger:hover {
                box-shadow: 0 8px 20px rgba(110, 168, 254, 0.1) !important;
                border-color: #5c8ed6 !important;
            }

        body.dark-mode .custom-select-wrapper.open .custom-select-trigger {
            border-color: #6ea8fe !important;
            box-shadow: 0 0 0 3px rgba(110, 168, 254, 0.2) !important;
        }

        body.dark-mode .custom-options {
            background-color: #2a2a2a !important;
            border-color: #444 !important;
            box-shadow: 0 25px 50px rgba(0,0,0,0.6) !important;
        }

        body.dark-mode .custom-option {
            color: #cbd5e1 !important;
            border-bottom: 1px solid #333;
        }

            body.dark-mode .custom-option::before {
                background-color: #6ea8fe;
            }

            body.dark-mode .custom-option:hover {
                background-color: #1e1e1e !important;
                color: #6ea8fe !important;
            }

            body.dark-mode .custom-option.selected {
                background-color: #6ea8fe !important;
                color: #121212 !important;
            }

        body.dark-mode .custom-options::-webkit-scrollbar-track {
            background: #2a2a2a;
        }

        body.dark-mode .custom-options::-webkit-scrollbar-thumb {
            background-color: #444;
            border-color: #2a2a2a;
        }

        body.dark-mode table, body.dark-mode td, body.dark-mode th {
            background-color: #1e1e1e !important;
            color: #f8f9fa !important;
            border-color: #333 !important;
        }

        body.dark-mode thead {
            background-color: #2a2a2a !important;
        }

        body.dark-mode th {
            border-bottom: 2px solid #444 !important;
            color: #6ea8fe !important;
        }

        body.dark-mode tbody tr:hover td {
            background-color: #2a2a2a !important;
        }

        body.dark-mode #firmaTable tfoot td {
            background-color: #2a2a2a !important;
            color: #f8f9fa !important;
            border-top: 2px solid #555 !important;
        }

        body.dark-mode .total-count-wrapper {
            color: #f8f9fa !important;
        }

        body.dark-mode .range-info {
            color: #b0b0b0 !important;
        }

        body.dark-mode .count-badge {
            background-color: #6ea8fe;
            color: #121212;
            font-weight: bold;
        }

        body.dark-mode .page-btn {
            background: #1e1e1e;
            border-color: #444;
            color: #6ea8fe;
        }

            body.dark-mode .page-btn:hover:not(.disabled) {
                background: #333;
            }

            body.dark-mode .page-btn.active {
                background: #6ea8fe;
                color: #121212;
                border-color: #6ea8fe;
            }

        body.dark-mode .empty-state {
            color: #b0b0b0 !important;
        }

        body.dark-mode a.text-primary {
            color: #6ea8fe !important;
        }
    </style>
</head>
<body>

    <header class="header">
        <div class="logo-container">
            <img src="/images/ito-logo.png" alt="İTO Logo" class="logo-img">
        </div>
        <h1>Üye Firma Sorgulama</h1>

        <div class="theme-btn-wrapper">
            <button id="theme-toggle">
                <span id="theme-icon">🌙</span> <span id="theme-text">Koyu Mod</span>
            </button>
        </div>
    </header>

    <main class="container">
        <section class="search-panel">
            <div class="form-group row-3">
                <div class="input-item">
                    <label for="odaSicil">Oda Sicil No</label>
                    <input type="text" id="odaSicil" placeholder="Oda Sicil No">
                </div>
                <div class="input-item">
                    <label for="ilceKodu">İlçe Kodu</label>
                    <input type="text" id="ilceKodu" placeholder="00">
                </div>
                <div class="input-item">
                    <label for="ticaretSicil">Ticaret Sicil No</label>
                    <input type="text" id="ticaretSicil" placeholder="Ticaret Sicil No">
                </div>
            </div>

            <div class="form-group row-title">
                <div class="input-item full-width">
                    <label for="unvan">Ünvan</label>
                    <div class="search-input-wrapper">
                        <input type="text" id="unvan" placeholder="Firma ünvanı yazın (Harf girdikçe filtrelenecek...)">
                        <button class="btn-search" id="btnSearch">Sorgula</button>
                    </div>
                </div>
            </div>

            <div class="form-group row-select">
                <div class="input-item full-width">
                    <label for="meslekGrubu">Meslek Grubu</label>
                    <select id="meslekGrubu">
                        <option value="">Seçiniz</option>
                        <option value="01">01-YAŞ SEBZE MEYVE GRUBU</option>
                        <option value="02">02-KURUTULMUŞ MEYVE VE ÇEREZLER GRUBU</option>
                        <option value="03">03-TARIMSAL HAMMADDE ARACILARI PAMUK TÜTÜN VE BAHARATÇILAR GRUBU</option>
                        <option value="04">04-HUBUBAT BAKLİYAT YAĞLI TOHUMLAR VE YEM GRUBU</option>
                        <option value="05">05-SÜS BİTKİLERİ, PEYZAJ VE EV HAYVANLARI GRUBU</option>
                        <option value="06">06-SU ÜRÜNLERİ, BALIKÇILIK VE AV MALZEMELERİ GRUBU</option>
                        <option value="07">07-SÜT GRUBU</option>
                        <option value="08">08-CANLI HAYVAN, KANATLI, ET VE ET ÜRÜNLERİ GRUBU</option>
                        <option value="09">09-EKMEK VE UNLU MAMULLER GRUBU</option>
                        <option value="10">10-PASTA VE ŞEKERLEME GRUBU</option>
                        <option value="11">11-GIDA İMALAT VE TOPTAN TİCARET GRUBU</option>
                        <option value="12">12-GIDA VE TÜKETİM MADDELERİ PERAKENDE SATICILARI GRUBU</option>
                        <option value="13">13-İÇECEK GRUBU</option>
                        <option value="14">14-KUMAŞ VE TUHAFİYE GRUBU</option>
                        <option value="15">15-KONFEKSİYON MALZEMELERİ VE MAKİNALARI GRUBU</option>
                        <option value="16">16-GİYİM EŞYALARI İMALAT VE TOPTAN TİCARETİ GRUBU</option>
                        <option value="17">17-GİYİM EŞYALARI PERAKENDE TİCARETİ GRUBU</option>
                        <option value="18">18-DERİ KONFEKSİYON VE SARACİYE GRUBU</option>
                        <option value="19">19-AYAKKABI GRUBU</option>
                        <option value="20">20-KOZMETİK GRUBU</option>
                        <option value="21">21-KİŞİSEL BAKIM, KUAFÖR, GÜZELLİK SALONLARI VE KURU TEMİZLEME GRUBU</option>
                        <option value="22">22-MÜCEVHER SAAT VE HEDİYELİK EŞYA GRUBU</option>
                        <option value="23">23-HALİ ZEMİN VE DUVAR KAPLAMALARI GRUBU</option>
                        <option value="24">24-MOBİLYA GRUBU</option>
                        <option value="25">25-EV TEKSTİL ÜRÜNLERİ VE MEFRUŞAT GRUBU</option>
