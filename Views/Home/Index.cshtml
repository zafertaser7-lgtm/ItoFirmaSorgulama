    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            function setupCustomSelects() {
                const selects = document.querySelectorAll('select');

                selects.forEach(select => {
                    select.style.display = 'none';

                    const wrapper = document.createElement('div');
                    wrapper.className = 'custom-select-wrapper';

                    const trigger = document.createElement('div');
                    trigger.className = 'custom-select-trigger';
                    const selectedText = select.options[select.selectedIndex]?.text || 'Seçiniz';
                    trigger.innerHTML = `<span>${selectedText}</span> <span class="arrow">▼</span>`;

                    const optionsList = document.createElement('div');
                    optionsList.className = 'custom-options';

                    Array.from(select.options).forEach((option, index) => {
                        const optionDiv = document.createElement('div');
                        optionDiv.className = 'custom-option';
                        if (index === select.selectedIndex && option.value !== "") {
                            optionDiv.classList.add('selected');
                        }
                        optionDiv.textContent = option.text;
                        optionDiv.dataset.value = option.value;

                        optionDiv.addEventListener('click', function(e) {
                            e.stopPropagation();

                            optionsList.querySelectorAll('.custom-option').forEach(el => el.classList.remove('selected'));
                            this.classList.add('selected');
                            trigger.querySelector('span').textContent = this.textContent;

                            wrapper.classList.remove('open');

                            select.value = this.dataset.value;
                            select.dispatchEvent(new Event('change'));
                        });

                        optionsList.appendChild(optionDiv);
                    });

                    wrapper.appendChild(trigger);
                    wrapper.appendChild(optionsList);

                    select.parentNode.insertBefore(wrapper, select.nextSibling);

                    trigger.addEventListener('click', function(e) {
                        e.stopPropagation();
                        document.querySelectorAll('.custom-select-wrapper').forEach(cw => {
                            if (cw !== wrapper) cw.classList.remove('open');
                        });
                        wrapper.classList.toggle('open');
                    });
                });

                document.addEventListener('click', function() {
                    document.querySelectorAll('.custom-select-wrapper').forEach(cw => cw.classList.remove('open'));
                });
            }

            setupCustomSelects();

            const btnSearch = document.getElementById("btnSearch");
            const btnExcel = document.getElementById("btnExcel");
            const themeToggleBtn = document.getElementById('theme-toggle');

            let globalFirmalar = [];
            let currentPage = 1;
            const pageSize = 500;

            function filtreleriCalistir(e) {
                if (e) e.preventDefault();

                btnSearch.innerHTML = '<span class="spinner"></span> Aranıyor...';
                btnSearch.disabled = true;

                const kelime = document.getElementById("unvan").value;
                const ilce = document.getElementById("ilcesi").value;
                const meslek = document.getElementById("meslekGrubu").value;
                const odaSicil = document.getElementById("odaSicil").value;
                const ticaretSicil = document.getElementById("ticaretSicil").value;

                const url = `/Home/FirmaAra?kelime=${encodeURIComponent(kelime)}&ilce=${encodeURIComponent(ilce)}&meslek=${encodeURIComponent(meslek)}&odaSicil=${encodeURIComponent(odaSicil)}&ticaretSicil=${encodeURIComponent(ticaretSicil)}`;

                fetch(url)
                    .then(r => r.json())
                    .then(data => {
                        globalFirmalar = data;
                        currentPage = 1;
                        tabloyuDoldur();

                        btnSearch.innerHTML = 'Sorgula';
                        btnSearch.disabled = false;
                    })
                    .catch(err => {
                        console.error("Hata Detayı:", err);
                        Swal.fire({
                            icon: 'error',
                            title: 'Sorgu Hatası!',
                            text: 'Veritabanından sorgulama yapılırken teknik bir hata oluştu.',
                            confirmButtonColor: '#00509e'
                        });
                        btnSearch.innerHTML = 'Sorgula';
                        btnSearch.disabled = false;
                    });
            }

            function tabloyuDoldur() {
                const tbody = document.querySelector("#firmaTable tbody");
                const toplamFirma = document.getElementById("toplamFirma");
                const rangeInfo = document.getElementById("rangeInfo");
                const paginationContainer = document.getElementById("paginationContainer");

                tbody.innerHTML = "";

                if (!globalFirmalar || globalFirmalar.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="7" class="empty-state">Kayıt bulunamadı.</td></tr>`;
                    toplamFirma.textContent = "0";
                    rangeInfo.textContent = "";
                    paginationContainer.innerHTML = "";
                    toplamFirma.classList.remove("pulse-effect");
                    return;
                }

                const totalPages = Math.ceil(globalFirmalar.length / pageSize);
                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = Math.min(startIndex + pageSize, globalFirmalar.length);
                const currentData = globalFirmalar.slice(startIndex, endIndex);

                let html = "";
                currentData.forEach((firma, index) => {
                    let webLink = (firma.webAdresi && firma.webAdresi.trim() !== '')
                        ? `<a href="${firma.webAdresi.startsWith('http') ? firma.webAdresi : 'https://' + firma.webAdresi}" target="_blank" class="text-primary">Siteye Git</a>`
                        : '-';

                    html += `
                    <tr class="fade-in-row" style="animation-delay: ${Math.min(index * 0.015, 0.5)}s">
                        <td>${firma.odaSicilNo}</td>
                        <td>${firma.ticaretSicilNo}</td>
                        <td>${firma.meslekGrubu}</td>
                        <td><strong>${firma.unvan}</strong></td>
                        <td>${firma.ilceAdi}</td>
                        <td><small>${firma.adres}</small></td>
                        <td>${webLink}</td>
                    </tr>`;
                });

                tbody.innerHTML = html;
                toplamFirma.textContent = globalFirmalar.length;

                rangeInfo.textContent = `${startIndex + 1} - ${endIndex} aralığı gösteriliyor |`;

                renderPagination(totalPages);

                toplamFirma.classList.remove("pulse-effect");
                void toplamFirma.offsetWidth;
                toplamFirma.classList.add("pulse-effect");
            }

            function renderPagination(totalPages) {
                const paginationContainer = document.getElementById("paginationContainer");
                if (totalPages <= 1) {
                    paginationContainer.innerHTML = "";
                    return;
                }

                let html = "";
                html += `<button class="page-btn ${currentPage === 1 ? 'disabled' : ''}" data-page="${currentPage - 1}">Önceki</button>`;

                const maxVisible = 5;

                let startPage = Math.max(1, currentPage - 2);
                let endPage = Math.min(totalPages, startPage + maxVisible - 1);

                if (endPage - startPage < maxVisible - 1) {
                    startPage = Math.max(1, endPage - maxVisible + 1);
                }

                if (startPage > 1) {
                    html += `<button class="page-btn" data-page="1">1</button>`;
                    if (startPage > 2) html += `<span class="page-dots">...</span>`;
                }

                for (let i = startPage; i <= endPage; i++) {
                    html += `<button class="page-btn ${currentPage === i ? 'active' : ''}" data-page="${i}">${i}</button>`;
                }

                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) html += `<span class="page-dots">...</span>`;
                    html += `<button class="page-btn" data-page="${totalPages}">${totalPages}</button>`;
                }

                html += `<button class="page-btn ${currentPage === totalPages ? 'disabled' : ''}" data-page="${currentPage + 1}">Sonraki</button>`;

                paginationContainer.innerHTML = html;
            }

            document.getElementById('paginationContainer').addEventListener('click', function(e) {
                if (e.target.classList.contains('page-btn') && !e.target.classList.contains('disabled') && !e.target.classList.contains('active')) {
                    const newPage = parseInt(e.target.getAttribute('data-page'));
                    if (newPage >= 1 && newPage <= Math.ceil(globalFirmalar.length / pageSize)) {
                        currentPage = newPage;
                        tabloyuDoldur();
                        window.requestAnimationFrame(() => {
                            document.querySelector(".data-table-container").scrollTo({ top:0, behavior:"smooth" });
                        });
                    }
                }
            });

            if (btnSearch) {
                document.getElementById("ilcesi").addEventListener("change", () => {
                    filtreleriCalistir();
                });
                document.getElementById("meslekGrubu").addEventListener("change", () => {
                    filtreleriCalistir();
                });
                btnSearch.addEventListener("click", filtreleriCalistir);
                document.getElementById("unvan").addEventListener("keypress", function(event) {
                    if (event.key === "Enter") filtreleriCalistir();
                });
            }

            if (btnExcel) {
                btnExcel.addEventListener("click", function (e) {
                    btnExcel.disabled=true;
                    btnExcel.innerHTML=`<span class="spinner"></span> İndiriliyor...`;
                    if (e) e.preventDefault();

                    const kelime = document.getElementById("unvan").value;
                    const ilce = document.getElementById("ilcesi").value;
                    const meslek = document.getElementById("meslekGrubu").value;
                    const odaSicil = document.getElementById("odaSicil").value;
                    const ticaretSicil = document.getElementById("ticaretSicil").value;

                    window.location.href = `/Home/ExcelIndir?kelime=${encodeURIComponent(kelime)}&ilce=${encodeURIComponent(ilce)}&meslek=${encodeURIComponent(meslek)}&odaSicil=${encodeURIComponent(odaSicil)}&ticaretSicil=${encodeURIComponent(ticaretSicil)}`;
                });
            }

            // --- TEMA İŞLEMLERİ ---
            async function initTheme() {
                const savedTheme = localStorage.getItem('user-theme');
                if (savedTheme) {
                    applyTheme(savedTheme);
                    return;
                }

                try {
                    const response = await fetch('https://api.aladhan.com/v1/timingsByCity?city=Izmir&country=Turkey&method=13');
                    const data = await response.json();
                    const timings = data.data.timings;
                    const fajr = timings.Fajr;
                    const maghrib = timings.Maghrib;
                    const now = new Date();
                    const currentTimeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

                    if (currentTimeStr >= maghrib || currentTimeStr < fajr) {
                        applyTheme('dark');
                    } else {
                        applyTheme('light');
                    }
                } catch (error) {
                    const hour = new Date().getHours();
                    if (hour >= 19 || hour < 6) {
                        applyTheme('dark');
                    } else {
                        applyTheme('light');
                    }
                }
            }

            function applyTheme(theme) {
                const icon = document.getElementById('theme-icon');
                const btnText = document.getElementById('theme-text');

                if (theme === 'dark') {
                    document.body.classList.add('dark-mode');
                    if (icon) icon.textContent = '☀️';
                    if (btnText) btnText.textContent = 'Açık Mod';
                } else {
                    document.body.classList.remove('dark-mode');
                    if (icon) icon.textContent = '🌙';
                    if (btnText) btnText.textContent = 'Koyu Mod';
                }
            }

            function toggleTheme() {
                const isDark = document.body.classList.contains('dark-mode');
                const newTheme = isDark ? 'light' : 'dark';
                localStorage.setItem('user-theme', newTheme);
                applyTheme(newTheme);
            }

            initTheme();

            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', toggleTheme);
            }
        });
    </script>
</body>
</html>