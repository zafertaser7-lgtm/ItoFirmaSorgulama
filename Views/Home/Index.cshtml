        <!-- =====================================================
             SONUÇLAR
             ===================================================== -->

        <div class="result-header">

            <div>

                <div class="result-title">
                    Firma Sonuçları
                </div>

                <div class="result-description">
                    Arama sonuçlarındaki firmaların detaylarına
                    buradan ulaşabilirsiniz.
                </div>

            </div>

        </div>


        <section class="data-table-container">

            <table id="firmaTable">

                <thead>

                    <tr>

                        <th>Oda Sicil No</th>
                        <th>Ticaret Sicil No</th>
                        <th>Meslek Grubu</th>
                        <th>Ünvan</th>
                        <th>İlçe</th>
                        <th>Adres</th>
                        <th>Web Adresi</th>
                        <th>Detay</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td colspan="8"
                            class="empty-state">

                            Lütfen arama kriteri giriniz.

                        </td>

                    </tr>

                </tbody>

                <tfoot>

                    <tr>

                        <td colspan="8">

                            <div class="footer-content">

                                <div id="paginationContainer"
                                     class="pagination-container">
                                </div>

                                <div>

                                    <span id="rangeInfo"
                                          class="range-info">
                                    </span>

                                    Toplam Firma:

                                    <span id="toplamFirma"
                                          class="count-badge">
                                        0
                                    </span>

                                </div>

                            </div>

                        </td>

                    </tr>

                </tfoot>

            </table>

        </section>

    </main>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const btnSearch =
                document.getElementById("btnSearch");

            const btnExcel =
                document.getElementById("btnExcel");

            const themeToggle =
                document.getElementById("theme-toggle");

            const toplamFirma =
                document.getElementById("toplamFirma");

            const statResult =
                document.getElementById("statResult");


            let firmalar = [];

            let currentPage = 1;

            const pageSize = 100;


            function htmlGuvenli(value) {

                if (value === null ||
                    value === undefined) {

                    return "";
                }

                const div =
                    document.createElement("div");

                div.textContent =
                    String(value);

                return div.innerHTML;
            }


            function getSearchParams() {

                const params =
                    new URLSearchParams();


                params.set(
                    "kelime",
                    document
                        .getElementById("unvan")
                        .value
                        .trim()
                );


                params.set(
                    "ilce",
                    document
                        .getElementById("ilcesi")
                        .value
                );


                params.set(
                    "meslek",
                    document
                        .getElementById("meslekGrubu")
                        .value
                );


                params.set(
                    "odaSicil",
                    document
                        .getElementById("odaSicil")
                        .value
                        .trim()
                );


                params.set(
                    "ticaretSicil",
                    document
                        .getElementById("ticaretSicil")
                        .value
                        .trim()
                );


                return params;
            }


            function firmaAra() {

                btnSearch.disabled = true;

                btnSearch.innerHTML =
                    '<span class="spinner"></span>Aranıyor...';


                fetch(
                    "/Home/FirmaAra?" +
                    getSearchParams().toString()
                )
                .then(function (response) {

                    if (!response.ok) {

                        throw new Error(
                            "Sunucu hatası: " +
                            response.status
                        );
                    }

                    return response.json();

                })
                .then(function (data) {

                    firmalar =
                        Array.isArray(data)
                            ? data
                            : [];


                    currentPage = 1;

                    tabloyuDoldur();

                })
                .catch(function (error) {

                    console.error(error);

                    Swal.fire({
                        icon: "error",
                        title: "Sorgu Hatası",
                        text:
                            "Firmalar alınırken bir hata oluştu."
                    });

                })
                .finally(function () {

                    btnSearch.disabled = false;

                    btnSearch.innerHTML =
                        "Sorgula";

                });

            }


            function tabloyuDoldur() {

                const tbody =
                    document.querySelector(
                        "#firmaTable tbody"
                    );


                const rangeInfo =
                    document.getElementById(
                        "rangeInfo"
                    );


                if (firmalar.length === 0) {

                    tbody.innerHTML =
                        '<tr>' +
                        '<td colspan="8" class="empty-state">' +
                        'Kayıt bulunamadı.' +
                        '</td>' +
                        '</tr>';


                    toplamFirma.textContent =
                        "0";


                    statResult.textContent =
                        "0";


                    rangeInfo.textContent =
                        "";


                    renderPagination(0);

                    return;
                }


                const totalPages =
                    Math.ceil(
                        firmalar.length /
                        pageSize
                    );


                const start =
                    (currentPage - 1) *
                    pageSize;


                const end =
                    Math.min(
                        start + pageSize,
                        firmalar.length
                    );


                const currentData =
                    firmalar.slice(
                        start,
                        end
                    );


                let html = "";


                currentData.forEach(
                    function (firma) {

                        const id =
                            encodeURIComponent(
                                firma.id || ""
                            );


                        const web =
                            firma.webAdresi
                                ? String(
                                    firma.webAdresi
                                ).trim()
                                : "";


                        let webLink =
                            "-";


                        if (web !== "") {

                            const href =
                                web.startsWith(
                                    "http://"
                                ) ||
                                web.startsWith(
                                    "https://"
                                )
                                    ? web
                                    : "https://" + web;


                            webLink =
                                '<a class="web-link" href="' +
                                htmlGuvenli(href) +
                                '" target="_blank" ' +
                                'rel="noopener noreferrer">' +
                                'Siteye Git' +
                                '</a>';
                        }


                        html +=

                            "<tr>" +

                            "<td>" +
                            htmlGuvenli(
                                firma.odaSicilNo
                            ) +
                            "</td>" +

                            "<td>" +
                            htmlGuvenli(
                                firma.ticaretSicilNo
                            ) +
                            "</td>" +

                            "<td>" +
                            htmlGuvenli(
                                firma.meslekGrubu
                            ) +
                            "</td>" +

                            "<td><strong>" +
                            htmlGuvenli(
                                firma.unvan
                            ) +
                            "</strong></td>" +

                            "<td>" +
                            htmlGuvenli(
                                firma.ilceAdi
                            ) +
                            "</td>" +

                            "<td>" +
                            htmlGuvenli(
                                firma.adres
                            ) +
                            "</td>" +

                            "<td>" +
                            webLink +
                            "</td>" +

                            "<td>" +

                            '<a class="btn-detail" ' +
                            'href="/Home/FirmaDetay?id=' +
                            id +
                            '">' +

                            "Detay" +

                            "</a>" +

                            "</td>" +

                            "</tr>";

                    }
                );


                tbody.innerHTML =
                    html;


                toplamFirma.textContent =
                    firmalar.length.toLocaleString(
                        "tr-TR"
                    );


                statResult.textContent =
                    firmalar.length.toLocaleString(
                        "tr-TR"
                    );


                rangeInfo.textContent =
                    `${start + 1} - ${end} aralığı gösteriliyor |`;


                renderPagination(
                    totalPages
                );

            }


            function renderPagination(totalPages) {

                const container =
                    document.getElementById(
                        "paginationContainer"
                    );


                if (totalPages <= 1) {

                    container.innerHTML = "";

                    return;
                }


                let html = "";


                html +=
                    '<button class="page-btn ' +
                    (currentPage === 1
                        ? "disabled"
                        : "") +
                    '" data-page="' +
                    (currentPage - 1) +
                    '">' +
                    "Önceki" +
                    "</button>";


                const start =
                    Math.max(
                        1,
                        currentPage - 2
                    );


                const end =
                    Math.min(
                        totalPages,
                        start + 4
                    );


                if (start > 1) {

                    html +=
                        '<button class="page-btn" data-page="1">1</button>';


                    if (start > 2) {

                        html +=
                            '<span class="page-dots">...</span>';
                    }
                }


                for (
                    let i = start;
                    i <= end;
                    i++
                ) {

                    html +=
                        '<button class="page-btn ' +
                        (i === currentPage
                            ? "active"
                            : "") +
                        '" data-page="' +
                        i +
                        '">' +
                        i +
                        "</button>";
                }


                if (end < totalPages) {

                    if (end < totalPages - 1) {

                        html +=
                            '<span class="page-dots">...</span>';
                    }


                    html +=
                        '<button class="page-btn" data-page="' +
                        totalPages +
                        '">' +
                        totalPages +
                        "</button>";
                }


                html +=
                    '<button class="page-btn ' +
                    (currentPage === totalPages
                        ? "disabled"
                        : "") +
                    '" data-page="' +
                    (currentPage + 1) +
                    '">' +
                    "Sonraki" +
                    "</button>";


                container.innerHTML =
                    html;

            }


            document
                .getElementById(
                    "paginationContainer"
                )
                .addEventListener(
                    "click",
                    function (event) {

                        const button =
                            event.target.closest(
                                ".page-btn"
                            );


                        if (!button ||
                            button.classList.contains(
                                "disabled"
                            )) {

                            return;
                        }


                        const page =
                            Number(
                                button.dataset.page
                            );


                        const totalPages =
                            Math.ceil(
                                firmalar.length /
                                pageSize
                            );


                        if (
                            page < 1 ||
                            page > totalPages
                        ) {

                            return;
                        }


                        currentPage =
                            page;


                        tabloyuDoldur();


                        document
                            .querySelector(
                                ".data-table-container"
                            )
                            .scrollTo({
                                top: 0,
                                behavior: "smooth"
                            });

                    }
                );


            /* =========================================================
               ARAMA
               ========================================================= */

            btnSearch.addEventListener(
                "click",
                firmaAra
            );


            const aramaAlanlari = [
                "unvan",
                "odaSicil",
                "ticaretSicil"
            ];


            aramaAlanlari.forEach(
                function (alan) {

                    document
                        .getElementById(alan)
                        .addEventListener(
                            "keydown",
                            function (event) {

                                if (
                                    event.key ===
                                    "Enter"
                                ) {

                                    event.preventDefault();

                                    firmaAra();

                                }

                            }
                        );

                }
            );


            document
                .getElementById("ilcesi")
                .addEventListener(
                    "change",
                    firmaAra
                );


            document
                .getElementById("meslekGrubu")
                .addEventListener(
                    "change",
                    firmaAra
                );


            /* =========================================================
               EXCEL
               ========================================================= */

            btnExcel.addEventListener(
                "click",
                function () {

                    btnExcel.disabled =
                        true;


                    btnExcel.innerHTML =
                        '<span class="spinner"></span>' +
                        "Hazırlanıyor...";


                    window.location.href =
                        "/Home/ExcelIndir?" +
                        getSearchParams().toString();


                    setTimeout(
                        function () {

                            btnExcel.disabled =
                                false;


                            btnExcel.innerHTML =
                                "📊 Excel'e Aktar";

                        },
                        3000
                    );

                }
            );


            /* =========================================================
               TEMA
               ========================================================= */

            function applyTheme(theme) {

                const icon =
                    document.getElementById(
                        "theme-icon"
                    );


                const text =
                    document.getElementById(
                        "theme-text"
                    );


                if (theme === "dark") {

                    document.body.classList.add(
                        "dark-mode"
                    );


                    icon.textContent =
                        "☀️";


                    text.textContent =
                        "Açık Mod";

                }
                else {

                    document.body.classList.remove(
                        "dark-mode"
                    );


                    icon.textContent =
                        "🌙";


                    text.textContent =
                        "Koyu Mod";
                }

            }


            const savedTheme =
                localStorage.getItem(
                    "user-theme"
                );


            if (savedTheme) {

                applyTheme(
                    savedTheme
                );

            }
            else {

                applyTheme(
                    "light"
                );

            }


            themeToggle.addEventListener(
                "click",
                function () {

                    const isDark =
                        document.body.classList.contains(
                            "dark-mode"
                        );


                    const newTheme =
                        isDark
                            ? "light"
                            : "dark";


                    localStorage.setItem(
                        "user-theme",
                        newTheme
                    );


                    applyTheme(
                        newTheme
                    );

                }
            );

        });

    </script>

</body>

</html>