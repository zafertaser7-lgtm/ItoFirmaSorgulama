@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>İTO Üye Firma Sorgulama</title>

    <link rel="icon"
          href="/images/ito-logo.png"
          type="image/png">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            background: #f4f7fb;
            color: #1f2937;
            transition: background-color .2s ease, color .2s ease;
        }

        /* =========================================================
                   HEADER
                   ========================================================= */

        .header {
            background: linear-gradient(135deg, #003366, #0066b3);
            color: white;
            padding: 17px 35px;
            display: flex;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0,0,0,.15);
        }

        .logo-img {
            height: 55px;
            width: auto;
            margin-right: 18px;
        }

        .header h1 {
            font-size: 24px;
            font-weight: 600;
        }

        .theme-btn-wrapper {
            margin-left: auto;
        }

        #theme-toggle {
            border: 1px solid rgba(255,255,255,.5);
            background: rgba(255,255,255,.12);
            color: white;
            padding: 9px 15px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 600;
            transition: .2s;
        }

            #theme-toggle:hover {
                background: rgba(255,255,255,.25);
            }

        /* =========================================================
                   ANA CONTAINER
                   ========================================================= */

        .container {
            max-width: 1450px;
            margin: 30px auto;
            padding: 0 20px;
        }

        /* =========================================================
                   ÜST BİLGİ ALANI
                   ========================================================= */

        .welcome-box {
            margin-bottom: 22px;
        }

        .welcome-title {
            color: #003366;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .welcome-text {
            color: #6b7280;
            font-size: 14px;
        }

        /* =========================================================
                   İSTATİSTİK KARTLARI
                   ========================================================= */

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 20px 22px;
            box-shadow: 0 5px 18px rgba(0,0,0,.07);
            border: 1px solid #e7edf3;
        }

        .stat-title {
            color: #6b7280;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .stat-value {
            color: #003366;
            font-size: 25px;
            font-weight: 700;
        }

        .stat-description {
            color: #9ca3af;
            font-size: 12px;
            margin-top: 5px;
        }

        /* =========================================================
                   ARAMA PANELİ
                   ========================================================= */

        .search-panel {
            background: white;
            border-radius: 14px;
            padding: 28px;
            margin-bottom: 25px;
            box-shadow: 0 6px 22px rgba(0,0,0,.08);
            border: 1px solid #e7edf3;
        }

        .search-header {
            margin-bottom: 22px;
        }

        .search-title {
            font-size: 19px;
            font-weight: 700;
            color: #003366;
            margin-bottom: 5px;
        }

        .search-description {
            color: #6b7280;
            font-size: 13px;
        }

        .form-group {
            display: flex;
            gap: 18px;
            margin-bottom: 18px;
            align-items: flex-end;
        }

            .form-group:last-child {
                margin-bottom: 0;
            }

        .input-item {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

            .input-item label {
                font-size: 13px;
                font-weight: 700;
                color: #003366;
                margin-bottom: 7px;
            }

        input,
        select {
            width: 100%;
            height: 44px;
            border: 1px solid #ccd5df;
            border-radius: 7px;
            padding: 0 12px;
            font-size: 14px;
            background: white;
            color: #1f2937;
            transition: .2s;
        }

            input:hover,
            select:hover {
                border-color: #9bb4ca;
            }

            input:focus,
            select:focus {
                outline: none;
                border-color: #0066b3;
                box-shadow: 0 0 0 3px rgba(0,102,179,.12);
            }

        .search-input-wrapper {
            display: flex;
            gap: 10px;
        }

            .search-input-wrapper input {
                flex: 1;
            }

        /* =========================================================
                   BUTONLAR
                   ========================================================= */

        .btn-search {
            height: 44px;
            min-width: 125px;
            padding: 0 20px;
            border: none;
            border-radius: 7px;
            background: #198754;
            color: white;
            font-weight: 700;
            cursor: pointer;
            transition: .2s;
        }

            .btn-search:hover {
                background: #157347;
                transform: translateY(-1px);
            }

            .btn-search:disabled {
                background: #6c757d;
                cursor: wait;
                transform: none;
            }

        .btn-excel {
            height: 44px;
            padding: 0 20px;
            border: none;
            border-radius: 7px;
            background: #0066b3;
            color: white;
            font-weight: 700;
            cursor: pointer;
            transition: .2s;
        }

            .btn-excel:hover {
                background: #003f70;
                transform: translateY(-1px);
            }

            .btn-excel:disabled {
                opacity: .7;
                cursor: wait;
                transform: none;
            }

        .action-item {
            display: flex;
            align-items: flex-end;
        }

        /* =========================================================
                   SONUÇ BAŞLIĞI
                   ========================================================= */

        .result-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }

        .result-title {
            font-size: 19px;
            font-weight: 700;
            color: #003366;
        }

        .result-description {
            font-size: 13px;
            color: #6b7280;
        }

        /* =========================================================
                   TABLE
                   ========================================================= */

        .data-table-container {
            background: white;
            border-radius: 14px;
            overflow: auto;
            max-height: 650px;
            box-shadow: 0 5px 20px rgba(0,0,0,.08);
            border: 1px solid #e7edf3;
        }

        table {
            width: 100%;
            min-width: 1120px;
            border-collapse: collapse;
        }

        thead {
            position: sticky;
            top: 0;
            z-index: 5;
            background: #e9eef5;
        }

        th {
            padding: 14px;
            color: #003366;
            font-size: 13px;
            text-align: left;
            border-bottom: 2px solid #ccd5df;
            white-space: nowrap;
        }

        td {
            padding: 12px 14px;
            font-size: 13px;
            border-bottom: 1px solid #edf0f3;
            vertical-align: middle;
        }

        tbody tr:hover td {
            background: #f1f7fd;
        }

        .empty-state {
            text-align: center;
            padding: 45px !important;
            color: #6c757d;
        }

        .btn-detail {
            display: inline-block;
            background: #0066b3;
            color: white;
            padding: 7px 13px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 700;
            transition: .2s;
        }

            .btn-detail:hover {
                background: #003f70;
                transform: translateY(-1px);
            }

        .web-link {
            color: #0066b3;
            text-decoration: none;
            font-weight: 600;
        }

            .web-link:hover {
                text-decoration: underline;
            }

        /* =========================================================
                   FOOTER
                   ========================================================= */

        tfoot {
            position: sticky;
            bottom: 0;
        }

            tfoot td {
                background: #f1f4f7;
                border-top: 2px solid #ccd5df;
            }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .pagination-container {
            display: flex;
            gap: 5px;
            align-items: center;
            flex-wrap: wrap;
        }

        .page-btn {
            padding: 7px 11px;
            border: 1px solid #ccd5df;
            background: white;
            color: #0066b3;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 700;
        }

            .page-btn:hover:not(.disabled):not(.active) {
                background: #eef4fa;
            }

            .page-btn.active {
                background: #0066b3;
                color: white;
            }

            .page-btn.disabled {
                opacity: .4;
                cursor: not-allowed;
            }

        .page-dots {
            padding: 0 5px;
            color: #6c757d;
        }

        .range-info {
            margin-right: 8px;
            color: #6c757d;
            font-size: 13px;
        }

        .count-badge {
            background: #0066b3;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 700;
        }

        /* =========================================================
                   SPINNER
                   ========================================================= */

        .spinner {
            width: 15px;
            height: 15px;
            border: 2px solid rgba(255,255,255,.4);
            border-top-color: white;
            border-radius: 50%;
            display: inline-block;
            animation: spin .8s linear infinite;
            margin-right: 6px;
            vertical-align: middle;
        }

        @@keyframes spin {

            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        /* =========================================================
                   DARK MODE
                   ========================================================= */

        body.dark-mode {
            background: #111827;
            color: #f9fafb;
        }

            body.dark-mode .welcome-title,
            body.dark-mode .search-title,
            body.dark-mode .result-title {
                color: #bfdbfe;
            }

            body.dark-mode .welcome-text,
            body.dark-mode .search-description,
            body.dark-mode .result-description {
                color: #9ca3af;
            }

            body.dark-mode .stat-card,
            body.dark-mode .search-panel,
            body.dark-mode .data-table-container {
                background: #1f2937;
                border-color: #374151;
            }

            body.dark-mode .stat-title {
                color: #9ca3af;
            }

            body.dark-mode .stat-value {
                color: #bfdbfe;
            }

            body.dark-mode input,
            body.dark-mode select {
                background: #374151;
                color: white;
                border-color: #4b5563;
            }

                body.dark-mode input:focus,
                body.dark-mode select:focus {
                    border-color: #60a5fa;
                    box-shadow: 0 0 0 3px rgba(96,165,250,.15);
                }

            body.dark-mode .input-item label {
                color: #dbeafe;
            }

            body.dark-mode thead {
                background: #374151;
            }

            body.dark-mode th {
                color: #dbeafe;
                border-color: #4b5563;
            }

            body.dark-mode td {
                border-color: #374151;
            }

            body.dark-mode tbody tr:hover td {
                background: #374151;
            }

            body.dark-mode tfoot td {
                background: #374151;
                border-color: #4b5563;
            }

            body.dark-mode .page-btn {
                background: #1f2937;
                color: #93c5fd;
                border-color: #4b5563;
            }

                body.dark-mode .page-btn.active {
                    background: #60a5fa;
                    color: #111827;
                }

            body.dark-mode .range-info {
                color: #9ca3af;
            }

            body.dark-mode .web-link {
                color: #93c5fd;
            }

        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 900px) {

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .form-group {
                flex-direction: column;
                align-items: stretch;
            }

            .search-input-wrapper {
                flex-direction: column;
            }

            .btn-search {
                width: 100%;
            }

            .action-item {
                width: 100%;
            }

            .btn-excel {
                width: 100%;
            }

            .header {
                padding: 15px 20px;
            }

                .header h1 {
                    font-size: 18px;
                }

            .logo-img {
                height: 42px;
            }

            .welcome-title {
                font-size: 23px;
            }
        }

    </style>

</head>

<body>

    <header class="header">

        <img src="/images/ito-logo.png"
             alt="İTO Logo"
             class="logo-img">

        <h1>
            Üye Firma Sorgulama
        </h1>

        <div class="theme-btn-wrapper">

            <button id="theme-toggle"
                    type="button">

                <span id="theme-icon">🌙</span>

                <span id="theme-text">
                    Koyu Mod
                </span>

            </button>

        </div>

    </header>


    <main class="container">

        <!-- =====================================================
             HOŞ GELDİN
             ===================================================== -->

        <section class="welcome-box">

            <div class="welcome-title">
                Üye Firma Sorgulama
            </div>

            <div class="welcome-text">
                İzmir Ticaret Odası üye firmalarını
                sicil, ünvan, ilçe ve meslek grubuna göre
                sorgulayabilirsiniz.
            </div>

        </section>


        <!-- =====================================================
             İSTATİSTİKLER
             ===================================================== -->

        <section class="stats-grid">

            <div class="stat-card">

                <div class="stat-title">
                    Meslek Grubu
                </div>

                <div class="stat-value">
                    84
                </div>

                <div class="stat-description">
                    Sistemde kayıtlı meslek grubu
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-title">
                    Arama Sonucu
                </div>

                <div class="stat-value"
                     id="statResult">

                    0

                </div>

                <div class="stat-description">
                    Mevcut sorgudaki firma sayısı
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-title">
                    Durum
                </div>

                <div class="stat-value"
                     style="font-size:20px;">

                    Aktif

                </div>

                <div class="stat-description">
                    Firma sorgulama sistemi
                </div>

            </div>

        </section>


        <!-- =====================================================
             ARAMA
             ===================================================== -->

        <section class="search-panel">

            <div class="search-header">

                <div class="search-title">
                    Firma Ara
                </div>

                <div class="search-description">
                    Bir veya birden fazla kriter kullanarak
                    firma arayabilirsiniz.
                </div>

            </div>


            <!-- SİCİL BİLGİLERİ -->

            <div class="form-group">

                <div class="input-item">

                    <label for="odaSicil">
                        Oda Sicil No
                    </label>

                    <input type="text"
                           id="odaSicil"
                           placeholder="Oda Sicil No">

                </div>


                <div class="input-item">

                    <label for="ticaretSicil">
                        Ticaret Sicil No
                    </label>

                    <input type="text"
                           id="ticaretSicil"
                           placeholder="Ticaret Sicil No">

                </div>


                <div class="input-item">

                    <label for="ilcesi">
                        İlçe
                    </label>

                    <select id="ilcesi">

                        <option value="">
                            Tüm İlçeler
                        </option>

                        <option value="ALİAĞA">ALİAĞA</option>
                        <option value="BALÇOVA">BALÇOVA</option>
                        <option value="BAYINDIR">BAYINDIR</option>
                        <option value="BAYRAKLI">BAYRAKLI</option>
                        <option value="BERGAMA">BERGAMA</option>
                        <option value="BEYDAĞ">BEYDAĞ</option>
                        <option value="BORNOVA">BORNOVA</option>
                        <option value="BUCA">BUCA</option>
                        <option value="ÇEŞME">ÇEŞME</option>
                        <option value="ÇİĞLİ">ÇİĞLİ</option>
                        <option value="DİKİLİ">DİKİLİ</option>
                        <option value="FOÇA">FOÇA</option>
                        <option value="GAZİEMİR">GAZİEMİR</option>
                        <option value="GÜZELBAHÇE">GÜZELBAHÇE</option>
                        <option value="KARABAĞLAR">KARABAĞLAR</option>
                        <option value="KARABURUN">KARABURUN</option>
                        <option value="KARŞIYAKA">KARŞIYAKA</option>
                        <option value="KEMALPAŞA">KEMALPAŞA</option>
                        <option value="KINIK">KINIK</option>
                        <option value="KİRAZ">KİRAZ</option>
                        <option value="KONAK">KONAK</option>
                        <option value="MENDERES">MENDERES</option>
                        <option value="MENEMEN">MENEMEN</option>
                        <option value="NARLIDERE">NARLIDERE</option>
                        <option value="ÖDEMİŞ">ÖDEMİŞ</option>
                        <option value="SEFERİHİSAR">SEFERİHİSAR</option>
                        <option value="SELÇUK">SELÇUK</option>
                        <option value="TİRE">TİRE</option>
                        <option value="TORBALI">TORBALI</option>
                        <option value="URLA">URLA</option>

                    </select>

                </div>

            </div>


            <!-- ÜNVAN -->

            <div class="form-group">

                <div class="input-item">

                    <label for="unvan">
                        Firma Ünvanı
                    </label>

                    <div class="search-input-wrapper">

                        <input type="text"
                               id="unvan"
                               placeholder="Firma ünvanı yazın...">

                        <button class="btn-search"
                                id="btnSearch"
                                type="button">

                            Sorgula

                        </button>

                    </div>

                </div>

            </div>


            <!-- MESLEK + EXCEL -->

            <div class="form-group">

                <div class="input-item">

                    <label for="meslekGrubu">
                        Meslek Grubu
                    </label>

                    <select id="meslekGrubu">

                        <option value="">
                            Tüm Meslek Grupları
                        </option>

                        <option value="01">
                            01 - YAŞ SEBZE MEYVE GRUBU
                        </option>

                        <option value="02">
                            02 - KURUTULMUŞ MEYVE VE ÇEREZLER GRUBU
                        </option>

                        <option value="03">
                            03 - TARIMSAL HAMMADDE ARACILARI PAMUK TÜTÜN VE BAHARATÇILAR GRUBU
                        </option>

                        <option value="04">
                            04 - HUBUBAT BAKLİYAT YAĞLI TOHUMLAR VE YEM GRUBU
                        </option>

                        <option value="05">
                            05 - SÜS BİTKİLERİ, PEYZAJ VE EV HAYVANLARI GRUBU
                        </option>

                        <option value="06">
                            06 - SU ÜRÜNLERİ, BALIKÇILIK VE AV MALZEMELERİ GRUBU
                        </option>

                        <option value="07">
                            07 - SÜT GRUBU
                        </option>

                        <option value="08">
                            08 - CANLI HAYVAN, KANATLI, ET VE ET ÜRÜNLERİ GRUBU
                        </option>

                        <option value="09">
                            09 - EKMEK VE UNLU MAMULLER GRUBU
                        </option>

                        <option value="10">
                            10 - PASTA VE ŞEKERLEME GRUBU
                        </option>

                        <option value="11">
                            11 - GIDA İMALAT VE TOPTAN TİCARET GRUBU
                        </option>

                        <option value="12">
                            12 - GIDA VE TÜKETİM MADDELERİ PERAKENDE SATICILARI GRUBU
                        </option>

                        <option value="13">
                            13 - İÇECEK GRUBU
                        </option>

                        <option value="14">
                            14 - KUMAŞ VE TUHAFİYE GRUBU
                        </option>

                        <option value="15">
                            15 - KONFEKSİYON MALZEMELERİ VE MAKİNALARI GRUBU
                        </option>

                        <option value="16">
                            16 - GİYİM EŞYALARI İMALAT VE TOPTAN TİCARETİ GRUBU
                        </option>

                        <option value="17">
                            17 - GİYİM EŞYALARI PERAKENDE TİCARETİ GRUBU
                        </option>

                        <option value="18">
                            18 - DERİ KONFEKSİYON VE SARACİYE GRUBU
                        </option>

                        <option value="19">
                            19 - AYAKKABI GRUBU
                        </option>

                        <option value="20">
                            20 - KOZMETİK GRUBU
                        </option>

                        <option value="21">
                            21 - KİŞİSEL BAKIM, KUAFÖR, GÜZELLİK SALONLARI VE KURU TEMİZLEME GRUBU
                        </option>

                        <option value="22">
                            22 - MÜCEVHER SAAT VE HEDİYELİK EŞYA GRUBU
                        </option>

                        <option value="23">
                            23 - HALI ZEMİN VE DUVAR KAPLAMALARI GRUBU
                        </option>

                        <option value="24">
                            24 - MOBİLYA GRUBU
                        </option>

                        <option value="25">
                            25 - EV TEKSTİL ÜRÜNLERİ VE MEFRUŞAT GRUBU
                        </option>

                        <option value="26">
                            26 - EV ALETLERİ GRUBU
                        </option>

                        <option value="27">
                            27 - ELEKTRİK TEÇHİZATI VE TESİSATI GRUBU
                        </option>

                        <option value="28">
                            28 - ELEKTRONİK GRUBU
                        </option>

                        <option value="29">
                            29 - TELEKOMÜNİKASYON GRUBU
                        </option>

                        <option value="30">
                            30 - TIBBİ CİHAZ GRUBU
                        </option>

                        <option value="31">
                            31 - SAĞLIK GRUBU
                        </option>

                        <option value="32">
                            32 - GÖZLÜKÇÜLER GRUBU
                        </option>

                        <option value="33">
                            33 - AĞIZ VE DİŞ SAĞLIĞI GRUBU
                        </option>

                        <option value="34">
                            34 - GÜVENLİK VE DESTEK FAALİYETLERİ GRUBU
                        </option>

                        <option value="35">
                            35 - EĞİTİM GRUBU
                        </option>

                        <option value="36">
                            36 - MATBAACILIK GRUBU
                        </option>

                        <option value="37">
                            37 - KAĞIT VE AMBALAJ GRUBU
                        </option>

                        <option value="38">
                            38 - KİTAP KIRTASİYE BÜRO MAKİNELERİ VE OYUNCAK GRUBU
                        </option>

                        <option value="39">
                            39 - BİLGİSAYAR VE DONANIM TEKNOLOJİLERİ GRUBU
                        </option>

                        <option value="40">
                            40 - MEDYA VE FOTOĞRAFÇILIK GRUBU
                        </option>

                        <option value="41">
                            41 - TURİZM SEYAHAT ACENTELERİ GRUBU
                        </option>

                        <option value="42">
